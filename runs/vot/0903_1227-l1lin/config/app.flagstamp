-O3 -mcpu=cortex-a72 -std=c++17 -D__linux__ -D__PS_ENABLE_AIE__ -DPATCH_ROWS=64 -DPATCH_COLS=64 -DN_CHANNELS=32 -DCONV_IN_CH=3 -DCONV_KSIZE=7 -DCONV_STRIDE=2 -DCROP_ROWS=128 -DCROP_COLS=128 -DITER_CNT=1 -DFFT_ROW_WS=64 -DFFT_COL_WS=8 -DMEMTILE_TRANSPOSE=1 -DROI_CROP_PIPELINE=1 -DCMUL_SPLIT_ACCUM=1 -DCMUL_ACCUM_MEMTILE=0 -DTAIL_PARALLEL=1 -pthread -DIMPULSE_DR=10 "-DIMPULSE_DC=(-7)" -DFRAME_ROWS=1080 -DFRAME_COLS=1920 -DFRAME_SOURCE_VOT=1 -DVOT_RESIDENT_MAX_MB=700 -DVOT_STREAM_RING=8 -DVOT_DATA_DIR=/mnt/vot -DVOT_RESULTS_DIR=/mnt/vot-results -DVOT_SEQUENCE=car1 -DVOT_JOB=0 -DRESET_MUTANT=0 -DFRAME_RGB_MODE=1 -DSCENE_VERIFY=0 -DCMUL_H_SHIFT=15 -DB2_NULL_BINS=1 -DPSR_GATE_MIN=5.0 -DFILTER_MASK=0 -DFILTER_MASK_STAT=0 -DFILTER_MASK_STAT_WARM=5 -DFILTER_MASK_STAT_EVERY=20 -DVERBOSITY=0 -DPROGRESS_EVERY=25 -DFFT_DRAIN_DEPTH=1 -DFFT_SHIFT_CFG=3 -DIFFT_ROW_SHIFT_CFG=3 -DIFFT_COL_SHIFT_CFG=3 -DDUMP_BUFFERS=0 -DCSV_LOG=1 -DCSV_FLUSH_EVERY=200 -DPL_FREQ_MHZ=312.5 -DRC_TRACE_FRAMES=3 -DCONTROL_CU_RUNS=8 -DROI_CROP_USER_MANAGED=1 -DTARGET_H=64 -DTARGET_W=64 -DTARGET_PADDING=2.0 -DMOSSE_SIGMA=2.0 -DSIGMA_FACTOR=16.0 -DSIGMA_FROM_TARGET=0 -DMOSSE_ETA=0.05 -DFRAME_TEXTURE=1 -DFRAME_NOISE=2 -DBG_PAN=1 -DBG_PAN_R=31 -DBG_PAN_C=47 -DSCALE_N=33 -DSCALE_STEP=1.04 -DSCALE_ETA=0.025 -DSCALE_SIGMA_FACTOR=16.0 -DSCALE_TMPL_AREA=512 -DSCALE_CONF_MIN=2.0 -DSCALE_MIN_REL=0.5 -DSCALE_MAX_REL=2.0 -DHOLD_COAST=0 -DCOAST_DECAY=0.5 -DSCALE_MAX_STEP=2 -DOCCLUDE_MASK=0 -DOCCLUDE_SQUARE=8 -DTRAJECTORY=0 -DTRAJ_AMP_R=180.0 -DTRAJ_AMP_C=180.0 -DTRAJ_PERIOD=120.0 -DSCALE_TRAJ=0 -DSCALE_TRAJ_AMP=0.30 -DSCALE_TRAJ_PERIOD=200.0 -DOCCLUDE_PERIOD=0 -DOCCLUDE_LEN=1 -DOCCLUDE_START=30
